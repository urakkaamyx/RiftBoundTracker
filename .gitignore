bin/
obj/
*.user
.vs/

# Scratch output from ad hoc terminal commands at the repo root, not project content.
/output.txt

# Runtime data — the whole point is this isn't shipped or shared, it's generated per-install
App_Data/

# Local Claude Code settings
.claude/settings.local.json

# Screenshots/test scripts from Claude's own verification work — visible locally so they can be
# browsed in Explorer, never committed.
.claude/scratchpad/

# Publish output — any local test/publish folder at the repo root, not committed.
# Matched broadly (not just exact names like "Test/") since these get created ad hoc while
# testing published builds and it's easy to pick a name that isn't already covered here.
/publish*/
/[Tt]est*/
*.zip

# WebView2 per-install user-data cache (created next to any exe that embeds WebView2, wherever
# it's run from) — never something to commit regardless of which folder it shows up in.
**/*.WebView2/

# Personal desktop shortcuts, not project content.
*.lnk

# Reference docs from another AI's handoffs, not part of the app itself.
/Riftbound_DeckBuilder_CommunityRecommendations_Handoff.md
/Riftbound_Rules_Search_Architecture.md
/Riftbound_Ask_Rules_Architecture.md

# Working source art for logo/branding assets (Photoshop files, full-resolution masters) — only
# the processed copies under wwwroot/ are actually shipped/used by the app.
/Enter.png
/Enter_Hover.png
/logo.png
*.psd

# Generated training artifacts (datasets, LoRA adapters, merged/converted models) — reproducible
# from scripts/training/generate_dataset.py + train.py + merge.py, never committed.
/scripts/training/output/

# Local Python env + llama.cpp toolchain for the training scripts — reproducible from
# requirements.txt and a fresh clone/download, never committed (large, machine-specific).
/scripts/training/.venv/
/scripts/training/llama.cpp-src/
/scripts/training/llama.cpp-bin/
/scripts/training/__pycache__/
/scripts/training/*.zip

# Working/staging area for the Rules Engine collaboration (milestone zips, recovery audits,
# scratch extractions) - not the source of truth. The canonical engine source lives in
# /rules-engine/, checked in separately once a milestone is actually integrated.
/REWORK/
