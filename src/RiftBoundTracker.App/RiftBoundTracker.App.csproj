<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Windows-SDK-versioned TFM (rather than plain net10.0-windows) so Windows.Media.Ocr and
         other WinRT APIs are directly usable — this is what replaced Tesseract; see OcrService. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.26.3</Version>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Without this, Sdk.Web's default (console subsystem) means double clicking the exe pops
         a raw console window alongside the real desktop window, showing bare framework log
         lines like "Application is shutting down..." with nothing to obviously click to dismiss
         it. WinExe suppresses that; launching from an existing terminal (dotnet run, headless
         mode for scripting) still shows console output normally since a console is already
         attached. -->
    <OutputType>WinExe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3240.44" />
    <!-- Pure-managed PDF text extraction (no native deps) for parsing the official Core/Tournament
         Rules PDFs — see RulesPdfParser. -->
    <PackageReference Include="PdfPig" Version="0.1.10" />
    <!-- HTML parsing for the Rules Hub / errata article pages — see RulesHubParser, ErrataArticleParser. -->
    <PackageReference Include="HtmlAgilityPack" Version="1.11.72" />
    <!-- Fully local LLM inference (llama.cpp bindings) for Ask Rules' optional plain-language
         explanation layer — see LocalLlmExplanationProvider. CPU backend only: works on every
         machine with no GPU/driver dependency, at the cost of being slower than a GPU backend
         would be. A ~1B-2B GGUF model answering a few-sentence question from supplied evidence is
         fast enough on CPU (a few seconds) that the extra complexity of also shipping CUDA/Vulkan
         backends isn't worth it for this use case. -->
    <PackageReference Include="LLamaSharp" Version="0.27.0" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.27.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Run with debug console.bat" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Sdk.Web copies any loose project-directory file into the publish output by default (Content
       items default to CopyToPublishDirectory) — without this, App_Data (created locally by
       `dotnet run` for dev testing, and gitignored so it's never noticed in `git status`) rides
       along in the release zip. The self-update relauncher then robocopy /MIR's it onto the
       install dir, silently replacing a real user's database and images with whatever was sitting
       in the dev's local App_Data at publish time. -->
  <ItemGroup>
    <Content Remove="App_Data/**" />
    <None Remove="App_Data/**" />
  </ItemGroup>

  <!-- Combining Sdk.Web with UseWPF/UseWindowsForms drops System.IO from the implicit-usings set
       that Sdk.Web normally provides on its own — restore it globally rather than patching every
       file that touches File/Directory/Path/Stream. -->
  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

</Project>
