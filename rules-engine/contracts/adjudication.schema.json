{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RiftKeep Grounded Adjudication",
  "type": "object",
  "required": ["issues"],
  "properties": {
    "issues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["issueId", "status", "verdict", "reasoningSteps", "appliedEvidence", "rejectedEvidence", "assumptions", "missingFacts"],
        "properties": {
          "issueId": {"type": "string"},
          "status": {"enum": ["decided", "conditional", "insufficient"]},
          "verdict": {"type": ["string", "null"]},
          "reasoningSteps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["claim", "evidenceIds"],
              "properties": {
                "claim": {"type": "string"},
                "evidenceIds": {"type": "array", "minItems": 1, "items": {"type": "string"}}
              },
              "additionalProperties": false
            }
          },
          "appliedEvidence": {"type": "array", "items": {"type": "string"}},
          "rejectedEvidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["evidenceId", "reason"],
              "properties": {
                "evidenceId": {"type": "string"},
                "reason": {"type": "string"}
              },
              "additionalProperties": false
            }
          },
          "assumptions": {"type": "array", "items": {"type": "string"}},
          "missingFacts": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
