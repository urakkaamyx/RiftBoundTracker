{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "riftkeep://contracts/compiled_rule_catalog.schema.json",
  "title": "RiftKeep Compiled Rule Catalog",
  "type": "object",
  "required": ["schemaVersion", "metadata", "rules"],
  "properties": {
    "schemaVersion": {"const": 1},
    "metadata": {
      "type": "object",
      "required": ["ruleCount", "executableRuleCount", "policy"],
      "properties": {
        "ruleCount": {"type": "integer"},
        "executableRuleCount": {"type": "integer"},
        "policy": {"type": "string"}
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ruleId", "internalRuleId", "sourceId", "sourceText", "sourceTextHash", "conditions", "modalities", "effectTypes", "dependencies", "executable", "compilerConfidence"],
        "properties": {
          "ruleId": {"type": "string"},
          "internalRuleId": {"type": "string"},
          "sourceId": {"type": "string"},
          "sourceText": {"type": "string"},
          "sourceTextHash": {"type": "string"},
          "conditions": {"type": "array"},
          "modalities": {"type": "array", "items": {"type": "string"}},
          "effectTypes": {"type": "array", "items": {"type": "string"}},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "executable": {"type": "boolean"},
          "compilerConfidence": {"type": "string"}
        }
      }
    }
  }
}
