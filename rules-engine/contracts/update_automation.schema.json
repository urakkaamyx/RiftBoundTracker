{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "riftkeep://contracts/update_automation.schema.json",
  "title": "RiftKeep Update Automation Transaction",
  "type": "object",
  "required": [
    "schemaVersion",
    "transactionId",
    "createdAt",
    "status",
    "baselineFingerprint",
    "candidates"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "transactionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "createdAt": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "baselineFingerprint": {
      "type": "object",
      "required": [
        "sha256",
        "fileCount"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "fileCount": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "candidateId",
          "kind",
          "sourceId",
          "inputFile",
          "inputSha256",
          "byteLength"
        ],
        "properties": {
          "candidateId": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "core_rules_pdf",
              "tournament_rules_pdf",
              "official_snapshot",
              "reviewed_file"
            ]
          },
          "sourceId": {
            "type": "string"
          },
          "inputFile": {
            "type": "string"
          },
          "inputSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "byteLength": {
            "type": "integer",
            "minimum": 1
          },
          "registration": {
            "type": [
              "object",
              "null"
            ]
          },
          "target": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
