{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RiftKeep M11 LLM Explanation Draft",
  "type": "object",
  "required": ["schemaVersion", "parts"],
  "properties": {
    "schemaVersion": {"const": 1},
    "parts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["issueId", "declaredVerdict", "explanation", "citationIds"],
        "properties": {
          "issueId": {"type": "string", "pattern": "^I[1-9][0-9]*$"},
          "declaredVerdict": {"type": ["string", "null"]},
          "explanation": {"type": "string", "minLength": 1, "maxLength": 1200},
          "citationIds": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 160}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
