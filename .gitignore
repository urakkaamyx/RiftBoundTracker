bin/
obj/
*.user
.vs/

# Runtime data — the whole point is this isn't shipped or shared, it's generated per-install
App_Data/

# Local Claude Code settings
.claude/settings.local.json

# Publish output — any local test/publish folder at the repo root, not committed.
# Matched broadly (not just exact names like "Test/") since these get created ad hoc while
# testing published builds and it's easy to pick a name that isn't already covered here.
/publish*/
/[Tt]est*/
*.zip

# WebView2 per-install user-data cache (created next to any exe that embeds WebView2, wherever
# it's run from) — never something to commit regardless of which folder it shows up in.
**/*.WebView2/

# Personal desktop shortcuts, not project content.
*.lnk

# Reference doc from another AI's handoff, not part of the app itself.
/Riftbound_DeckBuilder_CommunityRecommendations_Handoff.md
